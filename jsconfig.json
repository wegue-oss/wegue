{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "checkJs": true,

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"],
      "APP/*": ["app/*"]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.vue",
    "app/**/*.js",
    "app/**/*.vue"
  ],
  "exclude": [
    "app-starter",
    "dist",
    "node_modules"
  ]
}